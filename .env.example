# ZANVROX public website environment template
#
# Copy to .env.local for local development. Do not commit real .env files.
# VITE_ values are browser-visible. RESEND_API_KEY is serverless/API-only and
# belongs in Vercel Environment Variables, not in frontend code.

# Browser-visible public website configuration.
VITE_SITE_URL=https://zanvrox.com
VITE_PUBLIC_APP_URL=https://app.zanvrox.com
VITE_APP_URL=https://app.zanvrox.com
VITE_CONTACT_LEAD_ENDPOINT=/api/contact-lead

# Serverless contact form delivery.
RESEND_API_KEY=
CONTACT_EMAIL_FROM=ZANVROX <support@zanvrox.com>
CONTACT_NOTIFICATION_EMAIL=support@zanvrox.com
